{
  "id": "multi-verso-kin",
  "name": "Multi-verso Kin",
  "version": "2.2.0",
  "apiVersion": 18,
  "entry": "plugin.js",
  "description": "Manga y manhwa en español de 4 fuentes: ZonaTMO (net y org) y ManhwaShot (ss y hot). Lector propio, búsqueda global, seguir leyendo y lectura sin conexión.",
  "author": "Lenoxlkz",
  "homepage": "https://github.com/Lenoxlkz/multi-verso-kin",
  "hosts": [
    "zonatmo.net",
    "*.zonatmo.net",
    "zonatmo.org",
    "*.zonatmo.org",
    "manhwass.lat",
    "*.manhwass.lat",
    "manhwashot.lat",
    "*.manhwashot.lat",
    "cdn.zonatmo.to",
    "*.cdn.zonatmo.to"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "screen",
    "storageLarge"
  ],
  "catalogOnly": true,
  "visualBrowser": true,
  "categories": [
    "manga"
  ],
  "color": "#7C5CFF",
  "icon": "icon.png",
  "screen": {
    "label": "Multi-verso",
    "labelEn": "Multi-verse",
    "icon": "magic",
    "menuOpens": "both",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir Multi-verso",
      "labelEn": "Open Multi-verse"
    },
    "settingsIn": "both"
  },
  "section": {
    "label": "Multi-verso",
    "labelEn": "Multi-verse"
  },
  "settings": [
    {
      "key": "cuentas",
      "label": "Cuentas",
      "labelEn": "Accounts",
      "type": "status"
    },
    {
      "key": "zt_user",
      "label": "Correo de ZonaTMO",
      "labelEn": "ZonaTMO email",
      "type": "text",
      "hint": "Opcional: solo si tienes cuenta",
      "hintEn": "Optional: only if you have an account"
    },
    {
      "key": "zt_pass",
      "label": "Contraseña de ZonaTMO",
      "labelEn": "ZonaTMO password",
      "type": "password"
    },
    {
      "key": "zt_token",
      "label": "Token de ZonaTMO",
      "labelEn": "ZonaTMO token",
      "type": "password",
      "hint": "Lo escribe «Entrar con ventana»",
      "hintEn": "Written by \"Sign in with a window\""
    },
    {
      "key": "ms_user",
      "label": "Usuario o correo de Manhwa",
      "labelEn": "Manhwa user or email",
      "type": "text",
      "hint": "Opcional: solo si tienes cuenta",
      "hintEn": "Optional: only if you have an account"
    },
    {
      "key": "ms_pass",
      "label": "Contraseña de Manhwa",
      "labelEn": "Manhwa password",
      "type": "password"
    },
    {
      "key": "ms_cookie",
      "label": "Cookies de Manhwa",
      "labelEn": "Manhwa cookies",
      "type": "password",
      "hint": "Las escribe «Entrar con ventana»",
      "hintEn": "Written by \"Sign in with a window\""
    },
    {
      "key": "win_zt",
      "label": "Entrar con ventana (ZonaTMO)",
      "labelEn": "Sign in with a window (ZonaTMO)",
      "type": "action"
    },
    {
      "key": "log_zt",
      "label": "Entrar con correo y contraseña (ZonaTMO)",
      "labelEn": "Email sign-in (ZonaTMO)",
      "type": "action"
    },
    {
      "key": "win_ms",
      "label": "Entrar con ventana (Manhwa)",
      "labelEn": "Sign in with a window (Manhwa)",
      "type": "action"
    },
    {
      "key": "log_ms",
      "label": "Entrar con usuario y contraseña (Manhwa)",
      "labelEn": "User sign-in (Manhwa)",
      "type": "action"
    },
    {
      "key": "salir",
      "label": "Salir de las cuentas",
      "labelEn": "Sign out",
      "type": "action",
      "clearSettings": [
        "zt_user",
        "zt_pass",
        "zt_token",
        "ms_user",
        "ms_pass",
        "ms_cookie"
      ],
      "confirm": "¿Borrar los datos de las cuentas guardadas en este plugin?",
      "confirmEn": "Erase the account data stored in this plugin?"
    },
    {
      "key": "ocultarPago",
      "type": "toggle",
      "label": "Ocultar capítulos de pago",
      "labelEn": "Hide paid chapters",
      "hint": "Oculta los capítulos marcados como premium en las fuentes.",
      "hintEn": "Hides chapters flagged as premium in the sources."
    }
  ],
